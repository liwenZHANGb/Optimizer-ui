<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.lwoptimizer</groupId>
    <artifactId>lw-optimizer-ui</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>LW Optimizer :: UI</name>
    <description>
        Web interface of the LW Optimizer. A front end only: pages, styles and scripts, served by
        a few lines of Java. Every optimization goes through the REST API of lw-optimizer
        (module optimizer-api), which runs separately.
    </description>

    <properties>
        <java.version>21</java.version>
        <leaflet.version>1.9.4</leaflet.version>
    </properties>

    <dependencies>
        <!-- Serves the static files. No optimizer code here: the browser calls the API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Map library of the routing screens, served locally. -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>leaflet</artifactId>
            <version>${leaflet.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- With "spring-boot:run", pages, styles and scripts are served straight from
                         src/main/resources: edit and reload, no restart. -->
                    <addResources>true</addResources>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
